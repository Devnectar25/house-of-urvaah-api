# Server Configuration
PORT=4000
NODE_ENV=development

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=postgres
PGPORT=5432

# Supabase Configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication Secrets
JWT_SECRET=your_super_secret_key
SESSION_SECRET=your_session_secret_key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OAuth (Google & Facebook)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=khushal.privan06@gmail.com
BREVO_SENDER_NAME=House of Urvaah
SENDER_EMAIL=khushal.privan06@gmail.com
SENDER_NAME=House of Urvaah

# Groq LLM API Keys (Automatic 3-key fallback switch)
GROQ_API_KEY_1=gsk_your_key_1
GROQ_API_KEY_2=gsk_your_key_2
GROQ_API_KEY_3=gsk_your_key_3
GROQ_MODEL=openai/gpt-oss-120b

# Shiprocket Logistics Configuration (Dual Mode: Mock & Real)
# Set to 'false' to switch from Mock mode to Real Live Shiprocket APIs:
SHIPROCKET_MOCK=true
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
# Optional: Permanent API User Token (if generated in Shiprocket Dashboard)
SHIPROCKET_API_TOKEN=
# Registered Pickup Location name in your Shiprocket Account (Settings -> Pickup Addresses):
SHIPROCKET_PICKUP_LOCATION_NAME=Primary Atelier
SHIPROCKET_PICKUP_PINCODE=411001
# Optional: Webhook Secret Token (from Shiprocket -> Settings -> API -> Webhooks)
SHIPROCKET_WEBHOOK_SECRET=your_webhook_secret

